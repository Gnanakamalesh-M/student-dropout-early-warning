# Build context hygiene. Two entries here are correctness, not size:
# `data/` and `models/` must not be baked into an image — data/raw holds the
# OULAD extract (redistribution terms are the dataset's, not ours) and a model
# baked into a layer cannot be rotated without a rebuild. Both are mounted.
.git
.github
.venv
venv
__pycache__
*.py[cod]
*.egg-info
.pytest_cache
.ruff_cache
.mypy_cache
.coverage
coverage.xml
htmlcov

data/
models/
reports/
notebooks/
docs/

frontend/node_modules
frontend/dist
node_modules

.env
*.log
