# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
coverage.xml
htmlcov/

# Environment / secrets
.env
.env.local
*.pem

# Data: never commit datasets. Structure is tracked via .gitkeep, provenance
# via docs/DATA_CARD.md. See ADR-0002.
data/raw/*
data/interim/*
data/processed/*
data/external/*
!data/**/.gitkeep

# Model artifacts are build outputs, not source. See ADR-0004.
models/*
!models/.gitkeep

# Reports are regenerated by the pipeline; only committed figures are tracked
# explicitly with `git add -f`.
reports/figures/*
!reports/figures/.gitkeep

# Experiment tracking
mlruns/
optuna*.db

# Notebooks: strip outputs before committing (pre-commit handles this).
.ipynb_checkpoints/

# Frontend
node_modules/
frontend/dist/
frontend/.vite/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
