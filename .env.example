# Copy to .env and adjust. Never commit .env.
# Loaded and validated by src/dropout_ews/config/settings.py.

# local | ci | staging | production
# Outside `local`, a real SECRET_KEY of >=32 chars is required or startup fails.
ENVIRONMENT=local
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://ews:ews@localhost:5432/ews

# Which storage the API reads from. `parquet` scores on demand and needs no
# database; `database` reads persisted predictions. Both satisfy the same
# repository interface, so this is configuration rather than a code path.
REPOSITORY_BACKEND=parquet

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-insecure-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Browser origins allowed to call the API with credentials, as a JSON list.
# Outside `local`, startup fails if this still contains localhost, uses plain
# http, is empty, or contains "*". A wildcard with credentials is rejected by
# browsers anyway, so it is refused at boot rather than on the first request.
# Deployed example: ["https://ews.university.edu"]
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Send Strict-Transport-Security. Leave false unless the API is actually served
# over HTTPS: on localhost it pins the browser to HTTPS for the max-age, which
# is a persistent and confusing self-inflicted outage.
FORCE_HTTPS=false

# Project root for data/ and models/. Leave unset for a source checkout or an
# editable install -- it is derived from the package location. It must be set
# when the package is installed non-editable (the Docker image sets it to
# /app), because the derivation then resolves inside site-packages and the API
# starts healthy while reporting model_loaded: false.
# DROPOUT_EWS_ROOT=

# Model artifact selection. Leave ACTIVE_MODEL_VERSION unset to load the
# newest artifact in MODEL_DIR.
MODEL_DIR=models
# ACTIVE_MODEL_VERSION=

# Optional LLM case-note summariser (ADR-0005). Off by default; with it off,
# deterministic templates render and the system is fully functional. It never
# receives raw student records, identifiers, or demographics — only the
# already-computed factor names and impact bands.
ENABLE_LLM_NARRATIVE=false
# ANTHROPIC_API_KEY=
