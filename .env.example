# Copy to .env and adjust. Never commit .env.
# Loaded and validated by src/dropout_ews/config/settings.py.

# local | ci | staging | production
# Outside `local`, a real SECRET_KEY of >=32 chars is required or startup fails.
ENVIRONMENT=local
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://ews:ews@localhost:5432/ews

# Which storage the API reads from. `parquet` scores on demand and needs no
# database; `database` reads persisted predictions. Both satisfy the same
# repository interface, so this is configuration rather than a code path.
REPOSITORY_BACKEND=parquet

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-insecure-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Model artifact selection. Leave ACTIVE_MODEL_VERSION unset to load the
# newest artifact in MODEL_DIR.
MODEL_DIR=models
# ACTIVE_MODEL_VERSION=

# Optional LLM case-note summariser (ADR-0005). Off by default; with it off,
# deterministic templates render and the system is fully functional. It never
# receives raw student records, identifiers, or demographics — only the
# already-computed factor names and impact bands.
ENABLE_LLM_NARRATIVE=false
# ANTHROPIC_API_KEY=
